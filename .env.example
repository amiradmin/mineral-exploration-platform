# Copy this file to .env; generate unique random secrets and never commit .env.
# This file is for local development/presentation, not production credentials.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:8085

# PostgreSQL 17 + PostGIS 3.5
POSTGRES_DB=data_mine
POSTGRES_USER=data_mine
POSTGRES_PASSWORD=replace-with-a-random-db-password

# Set false when importing or using real project data.
SEED_DEMO=true

# Synthetic GIS simulator (opt-in). Generate a separate random token.
# Keep false unless intentionally running the simulator.
GIS_SIMULATOR_ENABLED=false
GIS_SIMULATOR_TOKEN=replace-with-a-different-random-token
GIS_SIMULATOR_TARGET=T-001
GIS_SIMULATOR_INTERVAL_SECONDS=30

# JWT refresh cookie on HTTP localhost/LAN development only.
# Set both to true behind HTTPS before public deployment.
JWT_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
